# Copier ce fichier en .env puis adapter les valeurs.
DJANGO_SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=gestion-interne/
# PostgreSQL (recommandé) :
# DATABASE_URL=postgres://user:motdepasse@localhost:5432/groupe_marges
# Sans DATABASE_URL, SQLite est utilisé (dev uniquement).

# Copier ce fichier en .env puis adapter les valeurs. Ne jamais versionner le fichier .env.

# Clé secrète Django : au moins 50 caractères aléatoires (obligatoire en production).
# Générer : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# La changer invalide toutes les sessions (tout le monde est déconnecté).
DJANGO_SECRET_KEY=change-moi-par-une-longue-chaine-aleatoire

# Mode débogage : True en développement uniquement (prod.py force False).
DJANGO_DEBUG=True

# Noms de domaine autorisés, séparés par des virgules (obligatoire en production).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Adresse de l'administration : éviter « admin/ » (vérification comptes.W002).
DJANGO_ADMIN_URL=gestion-interne/

# Base de données. PostgreSQL obligatoire en production ; sans DATABASE_URL, SQLite est utilisé (dev).
# DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/groupe_marges

# Durée de vie des connexions à la base, en secondes.
# DB_CONN_MAX_AGE=60

# Rôle « Saisie » : nombre de mois précédents (en plus du mois en cours) où l'on peut modifier ses lignes.
# SAISIE_FENETRE_MODIFICATION_MOIS=1

# Nombre de proxys de confiance devant Django (Nginx = 1). Sert à lire la vraie IP du client
# pour le blocage anti-bruteforce et le journal. Défaut : 0 en dev, 1 en production.
# DJANGO_NB_PROXYS_DE_CONFIANCE=1

# --- Production uniquement ---
# Origines autorisées pour les formulaires (HTTPS), séparées par des virgules.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://marges.exemple.ci
# Redirection automatique vers HTTPS (laisser True derrière Nginx en HTTPS).
# DJANGO_SECURE_SSL_REDIRECT=True
# Durée HSTS en secondes (1 an par défaut). Mettre une valeur faible lors du premier déploiement.
# DJANGO_HSTS_SECONDS=31536000
